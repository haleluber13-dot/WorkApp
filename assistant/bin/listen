#!/data/data/com.termux/files/usr/bin/bash
# Print what the microphone hears.
#
#   listen              Android's recogniser, falling back to Gemini
#   listen --record     skip Android; record and let Gemini listen
#   listen --android    Android only, no fallback
#
# Never hangs: every path has a timeout.
set -uo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

hearing="auto"
case "${1:-}" in
    --record|--gemini) hearing="gemini" ;;
    --android)         hearing="android" ;;
    --help|-h)         sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

exec python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
import voice

speaker = voice.Voice(hearing=sys.argv[2], enabled=False)
if speaker.hearing == "gemini":
    print("recording... speak now", file=sys.stderr)
heard = speaker.listen()
if heard:
    print(heard)
else:
    print(speaker.last_problem or "nothing heard", file=sys.stderr)
    sys.exit(1)
' "$here" "$hearing"
